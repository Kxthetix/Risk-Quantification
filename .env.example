# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=True
APP_NAME="Cybersecurity Risk & Financial Impact Platform"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL async URL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cyber_risk_db

# Security & JWT Configuration
JWT_SECRET_KEY=super-secret-key-change-this-in-production-min-32-chars-length
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Server Host and Port
HOST=0.0.0.0
PORT=8000
