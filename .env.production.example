# ==============================================================================
# AI-Risk Analyzer - Production Environment Variables Baseline
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Application Environment
APP_ENV=production
DEBUG=false
PROJECT_NAME="AI-Risk Analyzer"
API_V1_STR=/api/v1

# Security & Authentication
JWT_SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_64_CHAR_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL with asyncpg)
POSTGRES_USER=cyber_admin
POSTGRES_PASSWORD=SECURE_POSTGRES_PASSWORD_HERE
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cyber_risk_prod
DATABASE_URL=postgresql+asyncpg://cyber_admin:SECURE_POSTGRES_PASSWORD_HERE@postgres:5432/cyber_risk_prod

# Redis Cache & Message Queue
REDIS_PASSWORD=SECURE_REDIS_PASSWORD_HERE
REDIS_URL=redis://:SECURE_REDIS_PASSWORD_HERE@redis:6379/0

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=300
RATE_LIMIT_AUTH_RPM=30
RATE_LIMIT_EXPENSIVE_RPM=60

# CORS & Trusted Origins
CORS_ORIGINS=https://app.example.com,https://api.example.com

# File Ingestion & Object Storage
MAX_UPLOAD_SIZE_MB=25
AWS_REGION=us-east-1
S3_ARTIFACTS_BUCKET=cyber-risk-prod-artifacts

# Logging & Telemetry
LOG_LEVEL=INFO
ENABLE_PROMETHEUS_METRICS=true
